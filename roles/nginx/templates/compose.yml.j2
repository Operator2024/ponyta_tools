{% from 'functions/compose.j2' import render_ports %}
{% set combined_vars = nginx_env_vars | combine(nginx_env_vars_extra) %}
---
version: '3.0'
services:
  nginx:
    build:
      dockerfile: ./Dockerfile
      context: .
      args:
        ENABLED_MODULES: headers-more
    environment:
      {% for name, value in combined_vars.items() %}
      - {{ (name | upper) ~ '=${' ~ (name | upper) ~ '}' }}
      {% endfor %}
      {{ render_ports(nginx_ports_vars, True) | indent(6) }}
      {%- if true %}{% endif %}
    image: nginx-hm:1.27-alpine
    ports:
      {{ render_ports(nginx_ports_vars) | indent(6) }}
      {%- if true %}{% endif %}
    volumes:
      - './nginx.conf:/etc/nginx/nginx.conf'
      - './templates:/etc/nginx/templates/'
      - './certs:/etc/nginx/ssl/'
      - './logs:/var/log/nginx'
    networks:
      local-network:
        ipv4_address: 172.16.248.250
    restart: unless-stopped

networks:
  local-network:
    ipam:
      driver: default
      config:
        - subnet: 172.16.248.248/30
          gateway: 172.16.248.249
