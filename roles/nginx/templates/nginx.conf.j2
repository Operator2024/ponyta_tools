{% from 'functions/common.j2' import render_map, render_http_upstream %}
{% from 'functions/stream.j2' import render_stream_common with context %}
{# {% include 'functions/stream.j2' %} #}
user  root;
worker_processes  2;

load_module "modules/ngx_http_headers_more_filter_module.so";

error_log /var/log/nginx/error.log debug;

events {
    worker_connections  2048;
    multi_accept on;
    use epoll;
}

http {
    server_tokens off;
    proxy_buffers 48 16k;
    proxy_buffer_size 16k;
    proxy_busy_buffers_size 24k;

    proxy_cache_path /tmp/cache levels=1:2 keys_zone=cache:60m max_size=1G use_temp_path=off;
    proxy_cache_methods GET HEAD;

    proxy_redirect     off;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $remote_addr;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   Host $host;
    # proxy_set_header   Connection "";

    {% for site in nginx_http_sites %}
    {% set site_safe = site | replace('.', '_') %}
    include /etc/nginx/conf.d/http/{{site_safe}}.conf;
    {% endfor %}

    {% if nginx_http_upstream %}
    {{ render_http_upstream(nginx_http_upstream) | indent(4) -}}
    {% endif -%}

    {% if nginx_http_map %}
    {{ render_map(nginx_http_map) -}}
    {% endif %}

    server {
        {# fixme #}
        listen 80 default_server;

        server_name "";
        return 444;
    }

}
stream {
    {{ render_stream_common(nginx_stream_common) | indent(4) }}
    {{ render_map(nginx_stream_map) }}
}
