# Prometheus Web Configuration
# Basic Authentication with bcrypt hashes
{% set prometheus_jobs = prometheus_jobs | combine(prometheus_jobs_extra, recursive=true) %}

basic_auth_users:
{% for user, hash in prometheus_hashed_users.items() %}
  {{ user }}: {{ hash }}
{% endfor %}
{% if prometheus_jobs.prometheus.scheme == "https" %}
tls_server_config:
  cert_file: /etc/prometheus/certs/tls.crt
  key_file: /etc/prometheus/certs/tls.key
{% endif %}
