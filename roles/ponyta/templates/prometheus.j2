scrape_configs:
  - job_name: "{{ promjob.job_name }}"
    {% if promjob.scrape_interval %}
    # Override the global default and scrape targets from this job every {{ promjob.scrape_interval }} seconds.
    scrape_interval: {{ promjob.scrape_interval }}
    {% endif %}
    {% if promjob.scheme == 'https' and promjob.server_name %}
    scheme: {{ promjob.scheme }}
    tls_config:
      cert_file: /etc/prometheus/certs/tls.crt
      key_file: /etc/prometheus/certs/tls.key
      insecure_skip_verify: false
      server_name: {{ promjob.server_name }}
    {% else %}
    scheme: http
    {% endif %}
    {% if promjob.basic_auth %}
    basic_auth:
      username: {{ promjob.basic_auth.username }}
      {% if promjob.basic_auth.password_file %}
      password_file: {{ promjob.basic_auth.password_file }}
      {% else %}
      password: {{ promjob.basic_auth.password }}
      {% endif %}
    {% endif %}

    {% if promjob.static_configs %}
    static_configs:
      - targets:
        {% for target in promjob.static_configs.targets %}
          - {{ target }}
        {% endfor %}
        labels:
        {% for label in promjob.static_configs.labels %}
          {{ label }}: {{ promjob.static_configs.labels[label] }}
        {% endfor %}
    {% endif %}